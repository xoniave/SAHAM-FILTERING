# real_eod = real completed-session IDX reference/snapshot + Yahoo Finance daily history cache
# csv      = real OHLCV CSV files from app/data/history/<SYMBOL>.csv
# demo     = synthetic UI testing; trading decisions are DISABLED in demo mode
MARKET_PROVIDER=real_eod
DATABASE_PATH=app/data/dashboard.sqlite3
SCAN_INTERVAL_SECONDS=15
MAX_HISTORY_BARS=320
REAL_EOD_HISTORY_PERIOD=2y
SCANNER_CACHE_SECONDS=180

# Calibration parameters (not final trading truths)
PIVOT_WINDOW=3
SIDEWAYS_MIN_BARS=18
SIDEWAYS_MAX_WIDTH_PCT=0.12
LEVEL_CLUSTER_TOLERANCE_PCT=0.015
LEVEL_TOUCH_TOLERANCE_PCT=0.012
BREAKOUT_BUFFER_PCT=0.003
NEAR_LEVEL_PCT=0.025
DO_NOT_CHASE_PCT=0.08
ENTRY_PATTERN_MAX_AGE_BARS=3
ENTRY_MAX_SUPPORT_DISTANCE_PCT=0.03
ENTRY_RETRACEMENT_WATCH_MAX_DISTANCE_PCT=0.045
ENTRY_MIN_ROOM_TO_RESISTANCE_PCT=0.025
ENTRY_MIN_LOCATION_RR=1.20
BREAKOUT_ENTRY_MAX_DISTANCE_PCT=0.04

# Pembaruan otomatis sesi EOD IDX saat server dashboard hidup.
AUTO_EOD_SYNC=true
AUTO_EOD_CHECK_SECONDS=1200
